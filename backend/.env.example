# Copy to .env and edit.
# PostgreSQL (the IR's database). Create the database first (pgAdmin, or: createdb analyst_reliability),
# then set your password below.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/analyst_reliability

# Quick local test without PostgreSQL (comment the line above, uncomment this):
# DATABASE_URL=sqlite:///analyst_reliability.db

# Where downloaded Yahoo Finance prices are cached (CSV per .KL symbol)
PRICE_CACHE_DIR=../data/prices
